+  # Ensure data roaming and tethering tweaks are set on startup
+  sudo settings put global data_roaming 1
+  sudo settings put global tether_dun_required 0
+  sudo settings put global network_metered_1 0
+  sudo settings put global network_metered_2 0
+ 
+  # Performance Optimizations: CPU Governor and I/O
+  if [ -d /sys/devices/system/cpu/cpufreq ]; then
+    echo "performance" | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor > /dev/null
+  fi
+  if [ -f /sys/block/mmcblk0/queue/read_ahead_kb ]; then
+    echo "2048" | sudo tee /sys/block/mmcblk0/queue/read_ahead_kb > /dev/null
+  fi
